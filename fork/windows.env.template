# Rain Harness fork 的 Windows 打包环境文件。
# 用法：Copy-Item fork\windows.env.template apps\desktop\.env.windows
# apps/desktop/.env.windows 被 git 忽略；本模板是它的可追踪来源。
#
# 值与上游 apps/desktop/.env.windows.example 同构，区别只在 DSH_DESKTOP_APP_ID：
# 换成 fork 自己的标识，安装器才不会把官方 DeepSeek Harness 当作同一产品去升级覆盖。

# 安装器身份。必须是点分的标识符，且不要与官方的 com.deepseek.harness 相同。
DSH_DESKTOP_APP_ID=com.rainroom.harness

# 更新/策略部署选择：test 或 production。本地自用选 test。
DSH_DESKTOP_AUTO_UPDATE_ENV=test

# --- 以下带 <必填> 的项必须替换成真实值，否则打包会在校验阶段直接报错退出 ---

# 强制更新策略来源。必须是纯 HTTPS origin：无 credentials、无 path、无 query、无 fragment。
# 例：https://updates.example.com
DSH_DESKTOP_MANDATORY_UPDATE_TEST_ORIGIN=<必填-https-origin>

# test 部署额外要求 allowedAuthOrigins 非空，每项同样是纯 HTTPS origin。
# production 部署则不允许出现 allowedAuthOrigins。
# 可选字段：allowedPageOrigins（默认取上面的 origin）、轮询与兜底页选项。
DSH_DESKTOP_MANDATORY_UPDATE_CONFIG={"allowedAuthOrigins":["<必填-https-origin>"]}

# 下载源 origin；test 部署必填，production 留空。
DOWNLOAD_TEST_ORIGIN=<必填-https-origin>
# test 发布批次标识：32 位小写十六进制。同一批次的重试与升级测试复用同一个值。
DOWNLOAD_TEST_RELEASE_ID=

# --- 可选：本地打包提速 ---

# 用于准备内置 dsh 运行时的 npm registry，默认官方源。
# DSH_DESKTOP_NPM_REGISTRY=https://registry.npmmirror.com

# NSIS 压缩级别 0-9，越低越快。
DSH_DESKTOP_WINDOWS_COMPRESSION_LEVEL=3

# 签名缓存 worker 数（1-8）。--unsigned 构建用不到签名，保留默认即可。
DSH_DESKTOP_WINDOWS_SIGNATURE_CACHE_CONCURRENCY=4

# --- 仅签名构建需要，--unsigned 构建留空 ---
DSH_DESKTOP_WINDOWS_CER_FILE=
DSH_DESKTOP_WINDOWS_SIGNTOOL=
DSH_DESKTOP_WINDOWS_KEY_CONTAINER=
DSH_DESKTOP_WINDOWS_TOKEN_PIN=
