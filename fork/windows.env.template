# Rain Harness fork 的 Windows 打包环境文件模板。
# 用法：复制为 apps/desktop/.env.windows（该文件被 git 忽略）。
# fork/install-green.ps1 发现它缺失时会自动生成最小版本，正常流程不需要手动复制。
#
# unsigned 构建（本 fork 的日常构建）只需要下面这一行：安装器身份。
# 它必须与官方的 com.deepseek.harness 不同，安装器才不会把官方版当作同一产品去升级覆盖。
DSH_DESKTOP_APP_ID=com.rainroom.harness

# --- 以下仅签名 / 发布构建需要，unsigned 构建会跳过；本 fork 不参与自动更新，留空即可 ---
# DSH_DESKTOP_AUTO_UPDATE_ENV=test
# DSH_DESKTOP_MANDATORY_UPDATE_TEST_ORIGIN=https://updates.example.com
# DSH_DESKTOP_MANDATORY_UPDATE_CONFIG={"allowedAuthOrigins":["https://login.example.com"]}
# DOWNLOAD_TEST_ORIGIN=https://downloads.example.com
# DOWNLOAD_TEST_RELEASE_ID=

# --- 可选：本地打包提速 ---
# DSH_DESKTOP_NPM_REGISTRY=https://registry.npmmirror.com
# DSH_DESKTOP_WINDOWS_COMPRESSION_LEVEL=3

# --- 仅签名构建需要，--unsigned 构建留空 ---
# DSH_DESKTOP_WINDOWS_CER_FILE=
# DSH_DESKTOP_WINDOWS_SIGNTOOL=
# DSH_DESKTOP_WINDOWS_KEY_CONTAINER=
# DSH_DESKTOP_WINDOWS_TOKEN_PIN=
